section#clients.section.container(aria-labelledby="clients-title")
  +section-heading("clients-title", "Clients & kind words")
    | Some of the teams that trusted us with their brands.

  ul.clients
    each client in clients
      li.client(class=`client--${client.id}`) #{ client.name }

  figure.testimonial
    span.testimonial__quote
      +icon("quote", 28)
    blockquote.testimonial__text
      p #{ testimonial.text }
    figcaption.testimonial__author
      span.avatar(aria-hidden="true") #{ testimonial.initials }
      span.testimonial__who
        span.testimonial__name #{ testimonial.name }
        span.testimonial__role #{ testimonial.role }
      span.dots(aria-hidden="true")
        - for (let i = 0; i < testimonial.slides; i++)
          span.dots__item(class={ "dots__item--active": i === testimonial.current })
