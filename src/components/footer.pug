footer#contact.footer
  .container
    .footer__top
      .footer__links
        each column in footerColumns
          .footer__col
            h2.footer__title #{ column.title }
            ul.footer__list
              each link in column.links
                li
                  a.footer__link(href=link.href) #{ link.label }

      .newsletter
        h2#newsletter-title.footer__title Newsletter
        p.newsletter__text Fresh case studies and design notes, once a month.

        #subscribed.success(role="status")
          p.success__msg
            +icon("check", 18)
            | You’re in! Check your inbox to confirm.
          p.success__note One email a month. No spam, unsubscribe anytime.

        form.form(action="#subscribed" method="get" aria-labelledby="newsletter-title")
          label.visually-hidden(for="email") Email address
          input#email.form__input(
            name="email"
            type="email"
            placeholder="Your email address"
            autocomplete="email"
            required
            aria-describedby="email-error"
          )
          button.btn.btn--primary.form__btn(type="submit") Subscribe
          p#email-error.form__error Please enter a valid email address.
          label.form__consent
            input(type="checkbox" name="agree" required)
            span I agree to the privacy policy

    .footer__bottom
      p.footer__copy © 2026 Keepsake. All rights reserved.
      +socials(socials)

a.to-top(href="#top" aria-label="Back to top")
  +icon("arrow-up", 18)
