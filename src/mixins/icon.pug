//- +icon(name, size): інлайн-SVG іконка, вибір розмітки через case/when
mixin icon(name, size = 16)
  case name
    when "mail"
      svg.icon(
        width=size
        height=size
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      )
        rect(x="3" y="5" width="18" height="14")
        path(d="M3 6l9 7 9-7")
    when "heart"
      svg.icon(width=size height=size viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
        path(
          d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        )
    when "plus"
      svg.icon(
        width=size
        height=size
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      )
        path(d="M12 4v16M4 12h16")
    when "burger"
      svg.icon(
        width=size
        height=size
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      )
        path(d="M3 6h18M3 12h18M3 18h18")
    when "close"
      svg.icon(
        width=size
        height=size
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      )
        path(d="M5 5l14 14M19 5L5 19")
    when "arrow-up"
      svg.icon(
        width=size
        height=size
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      )
        path(d="M12 20V5M5 12l7-7 7 7")
    when "chevron"
      svg.icon(
        width=size
        height=size
        viewBox="0 0 8 8"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      )
        path(d="M2 0.5l3.5 3.5L2 7.5")
    when "quote"
      svg.icon(width=size height=size viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
        path(d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z")
    when "check"
      svg.icon(width=size height=size viewBox="0 0 24 24" aria-hidden="true")
        circle.f-teal(cx="12" cy="12" r="11")
        path.s-footer(d="M7 12.5l3.2 3.2L17 9" fill="none" stroke-width="2.4")
    when "web"
      svg(width="40" height="40" viewBox="0 0 40 40" aria-hidden="true")
        rect.s-muted(x="4" y="7" width="32" height="22" fill="none" stroke-width="3")
        rect.f-teal(x="8" y="11" width="24" height="14")
        path.s-muted(d="M15 34h10" stroke-width="3")
    when "motion"
      svg(width="40" height="40" viewBox="0 0 40 40" aria-hidden="true")
        rect.f-text(x="5" y="8" width="30" height="24")
        rect.f-bg-light(x="9" y="12" width="22" height="16")
        path.f-accent(d="M17 15l8 5-8 5z")
    when "print"
      svg(width="40" height="40" viewBox="0 0 40 40" aria-hidden="true")
        rect.f-muted(x="11" y="6" width="18" height="10")
        rect.f-text(x="5" y="16" width="30" height="14")
        rect.f-white.s-text(x="11" y="24" width="18" height="10" stroke-width="2")
        circle.f-accent(cx="30" cy="20" r="1.8")
    when "illustration"
      svg.f-accent(width="40" height="40" viewBox="0 0 24 24" aria-hidden="true")
        path(
          d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        )
    default
      //- невідома назва іконки: нічого не виводимо
