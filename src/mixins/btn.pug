//- +btn(label, href, variant)(&attributes): кнопка-посилання.
//- block - необов'язковий вкладений вміст (наприклад, іконка перед текстом).
mixin btn(label, href = "#", variant = "primary")
  - let modifier = "btn--primary";
  case variant
    when "secondary"
      - modifier = "btn--secondary";
    when "primary"
      - modifier = "btn--primary";
  a.btn(class=modifier href=href)&attributes(attributes)
    if block
      block
    | #{ label }
